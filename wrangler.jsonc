{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tidy",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [{ "name": "STATE", "class_name": "TidyState" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TidyState"] }]
  // TIDY_MASTER_KEY is a secret; `bun run deploy` creates it. Run limits live in tidy.yml.
}
